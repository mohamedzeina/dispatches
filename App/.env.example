# Base URL of the Dispatches backend API (no trailing slash).
# Leave unset to use the deployed Render backend (the default in src/config.js).
# For local development, point it at your local backend:
#   REACT_APP_API_URL=http://localhost:8080
#
# Copy this file to `.env` and adjust. Create React App only reads env vars
# prefixed with REACT_APP_, and inlines them at build time — rebuild after changes.
REACT_APP_API_URL=https://node-social-zmra.onrender.com
